{
  "$defs": {
    "assertion": {
      "additionalProperties": false,
      "properties": {
        "actual": {
          "pattern": "^/(structuredContent|isError)(/(?:[^~/]|~0|~1)+)*$",
          "type": "string"
        },
        "expected": {},
        "id": {
          "$ref": "#/$defs/id"
        },
        "op": {
          "enum": [
            "exists",
            "not_exists",
            "eq",
            "ne",
            "in",
            "contains",
            "len_eq",
            "len_gte",
            "matches",
            "is_error"
          ]
        }
      },
      "required": [
        "actual",
        "op"
      ],
      "type": "object"
    },
    "cleanup": {
      "additionalProperties": false,
      "properties": {
        "arguments": {
          "type": "object"
        },
        "assertions": {
          "items": {
            "$ref": "#/$defs/assertion"
          },
          "type": "array"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "tool"
        },
        "tool": {
          "minLength": 1,
          "type": "string"
        },
        "when": {
          "enum": [
            "always",
            "on_success",
            "on_failure"
          ]
        }
      },
      "required": [
        "kind",
        "id",
        "tool",
        "arguments",
        "assertions",
        "when"
      ],
      "type": "object"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9_-]{1,63}$",
      "type": "string"
    },
    "repeat": {
      "additionalProperties": false,
      "properties": {
        "assertions": {
          "items": {
            "$ref": "#/$defs/assertion"
          },
          "minItems": 1,
          "type": "array"
        },
        "interval_seconds": {
          "maximum": 30,
          "minimum": 0,
          "type": "number"
        },
        "max_attempts": {
          "maximum": 240,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "max_attempts",
        "interval_seconds",
        "assertions"
      ],
      "type": "object"
    },
    "sleep": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "sleep"
        },
        "seconds": {
          "maximum": 30,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "kind",
        "id",
        "seconds"
      ],
      "type": "object"
    },
    "tool": {
      "additionalProperties": false,
      "properties": {
        "arguments": {
          "type": "object"
        },
        "assertions": {
          "items": {
            "$ref": "#/$defs/assertion"
          },
          "type": "array"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "tool"
        },
        "repeat_until": {
          "$ref": "#/$defs/repeat"
        },
        "tool": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "tool",
        "arguments",
        "assertions"
      ],
      "type": "object"
    }
  },
  "$id": "https://mcp-velociraptor.invalid/tests/scenarios/schema-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "business_purpose": {
      "minLength": 1,
      "type": "string"
    },
    "cleanup": {
      "items": {
        "$ref": "#/$defs/cleanup"
      },
      "type": "array"
    },
    "fixture_spec_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "required_snapshot": {
      "enum": [
        "Snapshot 187-固定IP+WindowsMCP开机自启",
        "Snapshot 189-Velociraptor-MCP可恢复验收基线"
      ]
    },
    "scenario_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$",
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "steps": {
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/tool"
          },
          {
            "$ref": "#/$defs/sleep"
          }
        ]
      },
      "minItems": 10,
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "scenario_id",
    "business_purpose",
    "required_snapshot",
    "fixture_spec_sha256",
    "steps",
    "cleanup"
  ],
  "type": "object"
}
