    "HostIdentity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "platform": {
          "const": "posix"
        },
        "device": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "inode": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "owner_uid": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "owner_gid": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "principal_uid": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "mode": {
          "type": "string",
          "pattern": "^[0-7]{4}$"
        },
        "acl_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
