                  "size",
                  "sha256"
                ]
              }
            },
            "required": [
              "relative_path",
              "endpoint",
              "identity",
              "observation_ref"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "endpoint": {
                      "const": "host"
                    }
                  },
                  "required": [
                    "endpoint"
                  ]
                },
                "then": {
                  "properties": {
                    "identity": {
                      "$ref": "#/$defs/HostIdentity"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "identity": {
                      "$ref": "#/$defs/GuestIdentity"
                    }
                  }
                }
              }
            ]
          },
          "minItems": 1
        }
