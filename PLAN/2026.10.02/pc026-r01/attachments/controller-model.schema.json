        },
        "method": {
          "enum": [
            "posix_fstat_full_acl",
            "windows_same_handle_fileid_security_descriptor"
          ]
        }
      },
      "required": [
        "schema_version",
        "kind",
        "relative_path",
        "endpoint",
        "identity",
        "acl_original",
        "observed_at",
        "method"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "endpoint": {
                "const": "host"
              }
            },
            "required": [
              "endpoint"
            ]
          },
          "then": {
            "properties": {
              "identity": {
                "$ref": "#/$defs/HostIdentity"
              },
              "method": {
                "const": "posix_fstat_full_acl"
              }
            }
          },
          "else": {
            "properties": {
              "identity": {
                "$ref": "#/$defs/GuestIdentity"
              },
              "method": {
                "const": "windows_same_handle_fileid_security_descriptor"
              }
            }
          }
        }
      ]
    }
