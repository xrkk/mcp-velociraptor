    },
    "GuestIdentity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "platform": {
          "const": "windows"
        },
        "volume_serial": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "file_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "owner_sid": {
          "type": "string",
          "pattern": "^S-1-(0|[1-9][0-9]*)(-(0|[1-9][0-9]*)){1,15}$"
        },
        "principal_sid": {
          "type": "string",
          "pattern": "^S-1-(0|[1-9][0-9]*)(-(0|[1-9][0-9]*)){1,15}$"
