{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Component library under controller OD01/03. Request/response direction/context selects exact named component; this root is NOT a direction-guess validator.",
  "$defs": {
    "push_request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "chunks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1048576
              },
              "chunk_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "count",
              "chunk_sha256"
            ]
          },
          "minItems": 1,
          "maxItems": 64
        }
      },
      "required": [
        "chunks"
      ]
    },
    "pull_request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {},
      "required": []
    },
    "push_response": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "success"
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "verified_offset": {
              "type": "integer",
              "minimum": 0
            },
            "accepted": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            }
          },
          "required": [
            "verified_offset",
            "accepted"
          ]
        }
      },
      "required": [
        "status",
        "result"
      ]
    },
    "pull_response": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "success"
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "verified_offset": {
              "type": "integer",
              "minimum": 0
            },
            "chunks": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "offset": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1048576
                  },
                  "chunk_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "offset",
                  "count",
                  "chunk_sha256"
                ]
              },
              "maxItems": 64
            }
          },
          "required": [
            "verified_offset",
            "chunks"
          ]
        }
      },
      "required": [
        "status",
        "result"
      ]
    },
